<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SysmlStudio.App.Views.BottomPanelView"
             x:DataType="vm:BottomPanelViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
    <DockPanel>
      <!-- Tabs and close -->
      <Border DockPanel.Dock="Top" Height="38" Padding="10,0,8,0"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <RadioButton Classes="chip-tab" GroupName="bottom" IsChecked="{Binding ShowsProblems}">
              <TextBlock Text="{Binding ProblemsHeader}" FontSize="13.5" />
            </RadioButton>
            <RadioButton Classes="chip-tab" GroupName="bottom" IsChecked="{Binding ShowsUsages}">
              <TextBlock Text="{Binding UsagesHeader}" FontSize="13.5" />
            </RadioButton>
          </StackPanel>
          <Button Grid.Column="2" Classes="flat" Padding="5" VerticalAlignment="Center"
                  Command="{Binding CloseCommand}" ToolTip.Tip="Close">
            <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
          </Button>
        </Grid>
      </Border>

      <Panel>
        <!-- Problems: a dot, the message, where -->
        <ScrollViewer IsVisible="{Binding ShowsProblems}">
          <StackPanel Margin="4,6">
            <TextBlock Text="No problems." Classes="faint" FontSize="13.5" Margin="12,6" IsVisible="{Binding HasNoProblems}" />
            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemRow">
                  <Button Classes="flat row" Padding="12,7"
                          Command="{Binding $parent[ItemsControl].((vm:BottomPanelViewModel)DataContext).OpenProblemCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,14,0"
                               Fill="{DynamicResource WarningBrush}" IsVisible="{Binding !IsError}" />
                      <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,14,0"
                               Fill="{DynamicResource ErrorBrush}" IsVisible="{Binding IsError}" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="14" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Location}" Classes="mono faint" FontSize="12"
                                 Margin="16,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Usages: how, the line, where -->
        <ScrollViewer IsVisible="{Binding ShowsUsages}">
          <ItemsControl ItemsSource="{Binding Usages}" Margin="4,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UsageRow">
                <Button Classes="flat row" Padding="12,7"
                        Command="{Binding $parent[ItemsControl].((vm:BottomPanelViewModel)DataContext).OpenUsageCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="76,*,Auto">
                    <TextBlock Text="{Binding Usage}" Classes="faint" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Snippet}" Classes="mono" FontSize="12.5"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Location}" Classes="mono faint" FontSize="12"
                               Margin="16,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
        xmlns:views="clr-namespace:SysmlStudio.App.Views"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="SysmlStudio.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="SysML Studio"
        Width="1600" Height="980"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource WorkbenchBrush}"
        FontFamily="{DynamicResource UiFont}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
    <KeyBinding Gesture="Shift+F12" Command="{Binding FindUsagesCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding FitCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Gesture="Insert" Command="{Binding AddCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelToolCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- ===== Title strip ===== -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="42">
        <TextBlock Grid.Column="0" Text="SYSML STUDIO" VerticalAlignment="Center"
                   FontSize="15" LetterSpacing="2.2" FontWeight="Medium"
                   Foreground="{DynamicResource AccentTextBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="18,0,0,0" VerticalAlignment="Center">
          <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" />
          <Button Classes="flat" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)">
            <ic:SymbolIcon Symbol="Save" FontSize="16" />
          </Button>
          <Button Classes="flat" Command="{Binding UndoCommand}" ToolTip.Tip="Undo">
            <ic:SymbolIcon Symbol="ArrowUndo" FontSize="16" />
          </Button>
          <Button Classes="flat" Command="{Binding RedoCommand}" ToolTip.Tip="Redo">
            <ic:SymbolIcon Symbol="ArrowRedo" FontSize="16" />
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding WindowTitle}" Classes="mono muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="flat" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Light / dark">
            <ic:SymbolIcon Symbol="WeatherMoon" FontSize="16" />
          </Button>
          <AutoCompleteBox Width="300" Height="30"
                           ItemsSource="{Binding SearchItems}"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           FilterMode="ContainsOrdinal"
                           PlaceholderText="Search elements"
                           FontSize="13"
                           MaxDropDownHeight="420" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Ribbon tabs ===== -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="14,6,14,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="primary" Padding="18,7" FontWeight="Normal" FontSize="14" Content="File">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Open folder…" Command="{Binding OpenFolderCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save all" Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Export as SVG…" Command="{Binding ExportSvgCommand}" />
                <MenuItem Header="Export as PNG…" Command="{Binding ExportPngCommand}" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <RadioButton Classes="tab ribbon-tab" GroupName="ribbon" Content="Home" IsChecked="True" x:Name="HomeTab" />
          <RadioButton Classes="tab ribbon-tab" GroupName="ribbon" Content="Diagram" x:Name="DiagramTab" />
          <RadioButton Classes="tab ribbon-tab" GroupName="ribbon" Content="View" x:Name="ViewTab" />
        </StackPanel>
        <Button Grid.Column="2" Classes="flat" Command="{Binding ToggleRibbonCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="ChevronUp" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="collapse" Classes="mono muted" FontSize="12" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ===== Ribbon body ===== -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"
            IsVisible="{Binding !IsRibbonCollapsed}">
      <Panel>
        <views:RibbonHome IsVisible="{Binding #HomeTab.IsChecked}" />
        <views:RibbonDiagram IsVisible="{Binding #DiagramTab.IsChecked}" />
        <views:RibbonView IsVisible="{Binding #ViewTab.IsChecked}" />
      </Panel>
    </Border>

    <!-- ===== Panes ===== -->
    <DockControl Grid.Row="3" Layout="{Binding Layout}" Margin="0" />

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="22">
          <TextBlock Text="{Binding IndexedSummary}" Classes="mono muted" FontSize="12" />
          <TextBlock Text="{Binding ErrorText}" Classes="mono error" FontSize="12" IsVisible="{Binding HasWorkspace}" />
          <TextBlock Text="{Binding WarningText}" Classes="mono warning" FontSize="12" IsVisible="{Binding HasWorkspace}" />
          <TextBlock Text="{Binding Caret}" Classes="mono muted" FontSize="12" />
          <TextBlock Text="{Binding ToolHint}" Classes="mono link" FontSize="12" IsVisible="{Binding HasTool}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="22">
          <TextBlock Text="{Binding SaveState}" Classes="mono muted" FontSize="12" />
          <TextBlock Text="{x:Static vm:ShellViewModel.Runtime}" Classes="mono muted" FontSize="12" />
          <TextBlock Text="{Binding Branch}" Classes="mono muted" FontSize="12" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The edit dialog, over everything -->
    <Panel Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource OverlayBrush}" IsVisible="{Binding HasDialog}">
      <views:EditDialogView DataContext="{Binding Dialog}" />
    </Panel>

  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="SysmlStudio.App.Views.SourceDocumentView"
             x:DataType="vm:SourceDocumentViewModel">
  <edit:TextEditor x:Name="Editor"
                   Margin="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CanvasInsets}"
                   Document="{Binding Text}"
                   ShowLineNumbers="True"
                   WordWrap="True"
                   FontFamily="{DynamicResource MonoFont}"
                   FontSize="13.5"
                   Padding="14,14,0,0"
                   Background="{DynamicResource CanvasBrush}"
                   Foreground="{DynamicResource TextBrush}"
                   LineNumbersForeground="{DynamicResource TextFaintBrush}"
                   HorizontalScrollBarVisibility="Disabled"
                   VerticalScrollBarVisibility="Auto" />
</UserControl>

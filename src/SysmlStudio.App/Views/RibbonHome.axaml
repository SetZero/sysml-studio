<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:views="clr-namespace:SysmlStudio.App.Views"
             xmlns:diag="clr-namespace:SysmlStudio.Diagrams;assembly=SysmlStudio.Diagrams"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SysmlStudio.App.Views.RibbonHome"
             x:DataType="vm:ShellViewModel">


  <StackPanel Orientation="Horizontal" Height="108">

    <!-- WORKSPACE -->
    <Border Classes="group">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="flat ribbon-large" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open a folder of .sysml files (Ctrl+O)">
            <StackPanel>
              <ic:SymbolIcon Symbol="FolderOpen" />
              <TextBlock Classes="label" Text="Open folder" />
            </StackPanel>
          </Button>
          <StackPanel Spacing="1">
            <Button Classes="flat ribbon-small" Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Save" /><TextBlock Text="Save" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding SaveAllCommand}">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="SaveMultiple" /><TextBlock Text="Save all" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding ExportSvgCommand}" ToolTip.Tip="Export the open diagram">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="ArrowDownload" /><TextBlock Text="Export…" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="WORKSPACE" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <!-- HISTORY -->
    <Border Classes="group">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Spacing="1">
          <Button Classes="flat ribbon-small" Command="{Binding UndoCommand}">
            <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="ArrowUndo" /><TextBlock Text="Undo" /></StackPanel>
          </Button>
          <Button Classes="flat ribbon-small" Command="{Binding RedoCommand}">
            <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="ArrowRedo" /><TextBlock Text="Redo" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="HISTORY" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ELEMENT -->
    <Border Classes="group">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <StackPanel Spacing="1">
            <Button Classes="flat ribbon-small" Command="{Binding RenameCommand}" ToolTip.Tip="Rename the selected element everywhere it is named (F2)">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Rename" /><TextBlock Text="Rename…" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding FindUsagesCommand}" ToolTip.Tip="Where the selected element is named (Shift+F12)">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Search" /><TextBlock Text="Find usages" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the selected element (Del)">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Delete" /><TextBlock Text="Delete" /></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Spacing="1">
            <Button Classes="flat ribbon-small" Command="{Binding AddCommand}" CommandParameter="part" ToolTip.Tip="Add a part inside the selected element">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Add" /><TextBlock Text="Add part" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding AddCommand}" CommandParameter="port" ToolTip.Tip="Add a port inside the selected element">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Add" /><TextBlock Text="Add port" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding AddSatisfyCommand}" ToolTip.Tip="Say which requirement the selected element satisfies">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Add" /><TextBlock Text="Add satisfy" /></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Spacing="1">
            <Button Classes="flat ribbon-small" Command="{Binding AddCommand}" ToolTip.Tip="Add any kind of element inside the selected one (Ins)">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Add" /><TextBlock Text="Add…" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding SetTypeCommand}" ToolTip.Tip="Set what the selected usage is typed by">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Edit" /><TextBlock Text="Set type…" /></StackPanel>
            </Button>
            <Button Classes="flat ribbon-small" Command="{Binding EditDocCommand}" ToolTip.Tip="Edit the selected element's doc comment">
              <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Edit" /><TextBlock Text="Doc comment…" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="ELEMENT" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <!-- DIAGRAM KIND -->
    <views:DiagramKindGroup />

    <!-- ARRANGE -->
    <Border Classes="group">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="flat ribbon-large" Command="{Binding RelayoutCommand}" ToolTip.Tip="Lay the diagram out again">
            <StackPanel><ic:SymbolIcon Symbol="Grid" /><TextBlock Classes="label" Text="Relayout" /></StackPanel>
          </Button>
          <Button Classes="flat ribbon-large" Command="{Binding FitCommand}" ToolTip.Tip="Ctrl+0">
            <StackPanel><ic:SymbolIcon Symbol="ScaleFit" /><TextBlock Classes="label" Text="Fit to view" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="ARRANGE" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <!-- IMAGE -->
    <Border Classes="group">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Spacing="1">
          <Button Classes="flat ribbon-small" Command="{Binding ExportPngCommand}">
            <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="Image" /><TextBlock Text="PNG" /></StackPanel>
          </Button>
          <Button Classes="flat ribbon-small" Command="{Binding ExportSvgCommand}">
            <StackPanel Orientation="Horizontal"><ic:SymbolIcon Symbol="DocumentImage" /><TextBlock Text="SVG" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="IMAGE" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <!-- MATURITY: the metadata definitions the model declares -->
    <Border Classes="group" BorderThickness="0">
      <Grid RowDefinitions="*,Auto">
        <WrapPanel Orientation="Horizontal" MaxWidth="300" Margin="0,4,0,0">
          <ItemsControl ItemsSource="{Binding MaturityKeywords}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel MaxWidth="300" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="flat" Padding="0" Margin="0,0,6,6"
                        Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SetMaturityCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Mark the selected element with this keyword">
                  <Border Classes="chip"><TextBlock Text="{Binding StringFormat='#{0}'}" /></Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="flat" Padding="0" Margin="0,0,6,6" Command="{Binding SetMaturityCommand}" CommandParameter=""
                  ToolTip.Tip="Remove the maturity keyword">
            <Border Classes="chip plain"><TextBlock Text="none" /></Border>
          </Button>
        </WrapPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="MATURITY" HorizontalAlignment="Center" />
      </Grid>
    </Border>

  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:views="clr-namespace:SysmlStudio.App.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SysmlStudio.App.Views.RibbonDiagram"
             x:DataType="vm:ShellViewModel">
  <StackPanel Orientation="Horizontal" Height="108">
    <views:DiagramKindGroup />
    <Border Classes="group">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="flat ribbon-large" Command="{Binding RelayoutCommand}">
            <StackPanel><ic:SymbolIcon Symbol="Grid" /><TextBlock Classes="label" Text="Relayout" /></StackPanel>
          </Button>
          <Button Classes="flat ribbon-large" Command="{Binding FitCommand}">
            <StackPanel><ic:SymbolIcon Symbol="ScaleFit" /><TextBlock Classes="label" Text="Fit to view" /></StackPanel>
          </Button>
          <Button Classes="flat ribbon-large" Command="{Binding SaveCommand}" ToolTip.Tip="Remember the open diagrams and where their nodes sit">
            <StackPanel><ic:SymbolIcon Symbol="Save" /><TextBlock Classes="label" Text="Save layout" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="ARRANGE" HorizontalAlignment="Center" />
      </Grid>
    </Border>
    <Border Classes="group" BorderThickness="0">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="flat ribbon-large" Command="{Binding ExportPngCommand}">
            <StackPanel><ic:SymbolIcon Symbol="Image" /><TextBlock Classes="label" Text="PNG" /></StackPanel>
          </Button>
          <Button Classes="flat ribbon-large" Command="{Binding ExportSvgCommand}">
            <StackPanel><ic:SymbolIcon Symbol="DocumentImage" /><TextBlock Classes="label" Text="SVG" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="caption" Text="IMAGE" HorizontalAlignment="Center" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

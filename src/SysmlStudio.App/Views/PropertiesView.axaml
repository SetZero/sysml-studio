<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             x:Class="SysmlStudio.App.Views.PropertiesView"
             x:DataType="vm:PropertiesViewModel"
             Background="{DynamicResource SurfaceBrush}">
  <Panel>
    <TextBlock Text="Nothing selected." Classes="muted" FontSize="13.5" Margin="14,16"
               IsVisible="{Binding !HasElement}" />

    <ScrollViewer IsVisible="{Binding HasElement}">
      <StackPanel>
        <!-- What it is -->
        <StackPanel Margin="14,14,14,12" Spacing="2">
          <TextBlock Text="{Binding KindCaption}" Classes="caption" />
          <TextBlock Text="{Binding Name}" Classes="heading" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding QualifiedName}" Classes="mono muted" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Name / value rows -->
        <ItemsControl ItemsSource="{Binding Rows}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PropertyRow">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="118,*" MinHeight="34">
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,0">
                    <TextBlock Text="{Binding Name}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
                  </Border>
                  <Panel Grid.Column="1" Margin="10,4">
                    <TextBlock Text="{Binding Value}" Classes="mono" FontSize="12.5" VerticalAlignment="Center"
                               TextWrapping="Wrap" IsVisible="{Binding IsPlain}" />
                    <Button Classes="flat" Padding="2,1" HorizontalAlignment="Left"
                            Command="{Binding $parent[ItemsControl].((vm:PropertiesViewModel)DataContext).FollowCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding IsLink}">
                      <TextBlock Text="{Binding Value}" Classes="mono link" FontSize="12.5" TextWrapping="Wrap" />
                    </Button>
                    <Border Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsChip}">
                      <TextBlock Text="{Binding Value}" />
                    </Border>
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Doc comment -->
        <StackPanel Margin="14,16,14,0" Spacing="8">
          <TextBlock Text="DOC COMMENT" Classes="caption" />
          <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" Padding="10,9" MinHeight="72">
            <Panel>
              <TextBlock Text="{Binding Documentation}" TextWrapping="Wrap" FontSize="13.5" IsVisible="{Binding HasDocumentation}" />
              <TextBlock Text="No doc comment." Classes="faint" FontSize="13.5" IsVisible="{Binding !HasDocumentation}" />
            </Panel>
          </Border>
        </StackPanel>

        <!-- Element operations -->
        <StackPanel Margin="14,20,14,16" Spacing="8">
          <TextBlock Text="ELEMENT OPERATIONS" Classes="caption" />
          <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,6,Auto,6,Auto"
                ToolTip.Tip="Graphical editing is the next milestone; edit the source tab for now."
                ToolTip.ShowOnDisabled="True">
            <Button Grid.Row="0" Grid.Column="0" Classes="outline" Content="Rename…" IsEnabled="False" />
            <Button Grid.Row="0" Grid.Column="2" Classes="outline" Content="Set typing…" IsEnabled="False" />
            <Button Grid.Row="2" Grid.Column="0" Classes="outline" Content="Add part" IsEnabled="False" />
            <Button Grid.Row="2" Grid.Column="2" Classes="outline" Content="Add port" IsEnabled="False" />
            <Button Grid.Row="4" Grid.Column="0" Classes="outline" Content="Add satisfy" IsEnabled="False" />
            <Button Grid.Row="4" Grid.Column="2" Classes="outline danger" Content="Delete" IsEnabled="False" />
          </Grid>
          <TextBlock Classes="mono faint" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="every operation → TokenStreamRewriter patch · re-parse gate · undo snapshot" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>

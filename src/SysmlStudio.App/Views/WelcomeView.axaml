<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:svc="clr-namespace:SysmlStudio.App.Services"
             x:Class="SysmlStudio.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel"
             Background="{DynamicResource CanvasBrush}">
  <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
    <TextBlock Text="Open a workspace" FontSize="30" />
    <TextBlock Classes="muted" FontSize="14.5" TextWrapping="Wrap" LineHeight="21"
               Text="Choose a folder of .sysml files. The text stays the source of truth." />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,18,0,0">
      <Button Classes="primary" Content="Open folder…" Command="{Binding OpenFolderCommand}" />
      <Button Classes="outline strong" Content="Try sample" Command="{Binding OpenSampleCommand}" Padding="12,7"
              IsVisible="{x:Static vm:WelcomeViewModel.HasSample}" />
    </StackPanel>

    <StackPanel Spacing="2" Margin="0,26,0,0" IsVisible="{Binding HasRecent}">
      <TextBlock Text="RECENT" Classes="caption" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding Recent}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:RecentFolder">
            <Button Classes="flat row" Padding="0,9"
                    Command="{Binding $parent[ItemsControl].((vm:WelcomeViewModel)DataContext).OpenRecentCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding Name}" FontSize="14.5" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ShortPath}" Classes="mono faint" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0"
                           TextTrimming="PathSegmentEllipsis" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>

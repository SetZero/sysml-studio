<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:views="clr-namespace:SysmlStudio.App.Views"
             x:Class="SysmlStudio.App.Views.ProjectBrowserView"
             x:DataType="vm:BrowserViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,16,12,6">
      <TextBlock Text="MODEL" Classes="caption" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding FilesText}" Classes="faint" FontSize="12" VerticalAlignment="Center" />
    </Grid>

    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}"
              ContextRequested="OnContextRequested" Background="Transparent" Padding="4,0"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:ElementViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <!-- Rows reach the right edge, so the "deferred" tag lines up there. -->
        <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:ElementViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="28" ToolTip.Tip="{Binding ToolTip}" Background="Transparent">
            <!-- What kind of thing: a square for a definition, a circle for a usage, dashed when deferred. -->
            <Panel Width="16" VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding !IsPackage}">
              <Border Width="9" Height="9" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.2"
                      IsVisible="{Binding ShowsSquare}" />
              <Ellipse Width="9" Height="9" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2"
                       IsVisible="{Binding ShowsCircle}" />
              <Rectangle Width="9" Height="9" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2"
                         StrokeDashArray="1.5,1.5" IsVisible="{Binding ShowsDashed}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="14.5"
                       TextTrimming="CharacterEllipsis"
                       FontWeight="{Binding IsRoot, Converter={x:Static views:Converters.BoldWhen}}" />
            <TextBlock Grid.Column="2" Text="{Binding Tag}" Classes="faint" FontSize="12.5" VerticalAlignment="Center"
                       Margin="8,0,8,0" />
          </Grid>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>

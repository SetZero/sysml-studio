<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SysmlStudio.App.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>

  <Application.Resources>
    <!-- Colour says one thing and only one: the maturity keyword the element
         carries. Everything else is shape. -->
    <SolidColorBrush x:Key="MaturityImplemented" Color="#2E7D32" />
    <SolidColorBrush x:Key="MaturityInProgress" Color="#F9A825" />
    <SolidColorBrush x:Key="MaturityWrittenAhead" Color="#0277BD" />
    <SolidColorBrush x:Key="MaturityPlanned" Color="#757575" />
    <SolidColorBrush x:Key="MaturityNone" Color="#455A64" />
  </Application.Resources>

</Application>

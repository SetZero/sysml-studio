<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:views="clr-namespace:SysmlStudio.App.Views"
             x:Class="SysmlStudio.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SysmlStudio.App/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- The document in front and the modal over the window find their views here. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:DiagramDocumentViewModel">
      <views:DiagramDocumentView />
    </DataTemplate>
    <DataTemplate DataType="vm:SourceDocumentViewModel">
      <views:SourceDocumentView />
    </DataTemplate>
    <DataTemplate DataType="vm:DialogViewModel">
      <views:EditDialogView />
    </DataTemplate>
    <DataTemplate DataType="vm:ExportDialogViewModel">
      <views:ExportDialogView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://SysmlStudio.App/Themes/Styles.axaml" />
  </Application.Styles>

</Application>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Type. Condensed sans for the interface, mono for anything that is
       model text: qualified names, paths, positions, source. -->
  <FontFamily x:Key="UiFont">avares://SysmlStudio.App/Assets/Fonts#IBM Plex Sans Condensed</FontFamily>
  <FontFamily x:Key="MonoFont">avares://SysmlStudio.App/Assets/Fonts#IBM Plex Mono</FontFamily>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Chrome: title bar, side panels, inspector, status bar. -->
      <SolidColorBrush x:Key="WorkbenchBrush" Color="#F4F4F4" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F4F4" />
      <!-- The frosting on the side panels that float over the canvas. -->
      <SolidColorBrush x:Key="GlassBrush" Color="#80F4F4F4" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#F7F7F7" />
      <!-- The canvas and the editor: a shade lighter than the chrome. -->
      <SolidColorBrush x:Key="CanvasBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="CanvasGridBrush" Color="#D6D6D6" />
      <SolidColorBrush x:Key="BorderBrush" Color="#E2E2E2" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#D2D2D2" />
      <SolidColorBrush x:Key="TextBrush" Color="#1E1F21" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#6C6E72" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#9A9CA0" />
      <SolidColorBrush x:Key="AccentBrush" Color="#6482A9" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#56749B" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E2E7EF" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#4E6D96" />
      <SolidColorBrush x:Key="NodeSelectedBrush" Color="#5A79A3" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#E0E6EE" />
      <SolidColorBrush x:Key="HoverBrush" Color="#EAEAEA" />
      <SolidColorBrush x:Key="SegmentBrush" Color="#EAEAEA" />
      <SolidColorBrush x:Key="EdgeBrush" Color="#9C9C9C" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#A23B3B" />
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#E9EDF3" />
      <SolidColorBrush x:Key="WarningBrush" Color="#B28B2B" />
      <SolidColorBrush x:Key="OverlayBrush" Color="#8C9A9DA3" />
      <SolidColorBrush x:Key="TooltipBrush" Color="#1C1C1E" />
      <SolidColorBrush x:Key="OnTooltipBrush" Color="#FFFFFF" />

      <!-- Maturity: the one thing colour means. -->
      <SolidColorBrush x:Key="MaturityImplemented" Color="#3F5F86" />
      <SolidColorBrush x:Key="MaturityInProgress" Color="#C39227" />
      <SolidColorBrush x:Key="MaturityWrittenAhead" Color="#86A6C9" />
      <SolidColorBrush x:Key="MaturityPlanned" Color="#B9BEC4" />
      <SolidColorBrush x:Key="MaturityNone" Color="#D2D4D6" />

      <!-- Syntax colours for the source editor: muted, and each apart from the text colour. -->
      <Color x:Key="SyntaxKeyword">#7A4AA8</Color>
      <Color x:Key="SyntaxComment">#8A8C90</Color>
      <Color x:Key="SyntaxString">#8A4F1D</Color>
      <Color x:Key="SyntaxNumber">#3D7A3A</Color>
      <Color x:Key="SyntaxMetadata">#4E6D96</Color>
      <Color x:Key="SyntaxType">#1E6F6B</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WorkbenchBrush" Color="#1E2023" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2023" />
      <SolidColorBrush x:Key="GlassBrush" Color="#8C1E2023" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2A2D31" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#212327" />
      <SolidColorBrush x:Key="CanvasBrush" Color="#18191C" />
      <SolidColorBrush x:Key="CanvasGridBrush" Color="#34373C" />
      <SolidColorBrush x:Key="BorderBrush" Color="#33363B" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#42464C" />
      <SolidColorBrush x:Key="TextBrush" Color="#E4E5E7" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#A2A5AA" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#6F7278" />
      <SolidColorBrush x:Key="AccentBrush" Color="#6F8FB8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#83A2C8" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C3746" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#9DB7D8" />
      <SolidColorBrush x:Key="NodeSelectedBrush" Color="#7F9DC4" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#2C3542" />
      <SolidColorBrush x:Key="HoverBrush" Color="#2A2D31" />
      <SolidColorBrush x:Key="SegmentBrush" Color="#2A2D31" />
      <SolidColorBrush x:Key="EdgeBrush" Color="#7A7E85" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#E0837D" />
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#262C35" />
      <SolidColorBrush x:Key="WarningBrush" Color="#D8B25A" />
      <SolidColorBrush x:Key="OverlayBrush" Color="#A6000000" />
      <SolidColorBrush x:Key="TooltipBrush" Color="#E4E5E7" />
      <SolidColorBrush x:Key="OnTooltipBrush" Color="#18191C" />

      <SolidColorBrush x:Key="MaturityImplemented" Color="#7C9CC4" />
      <SolidColorBrush x:Key="MaturityInProgress" Color="#D9AA45" />
      <SolidColorBrush x:Key="MaturityWrittenAhead" Color="#4F6F92" />
      <SolidColorBrush x:Key="MaturityPlanned" Color="#5A6068" />
      <SolidColorBrush x:Key="MaturityNone" Color="#3F444A" />

      <Color x:Key="SyntaxKeyword">#C3A2E0</Color>
      <Color x:Key="SyntaxComment">#7D8086</Color>
      <Color x:Key="SyntaxString">#D9A06A</Color>
      <Color x:Key="SyntaxNumber">#A8CF9E</Color>
      <Color x:Key="SyntaxMetadata">#9DB7D8</Color>
      <Color x:Key="SyntaxType">#86CBC4</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

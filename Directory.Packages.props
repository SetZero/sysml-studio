<Project>
  <ItemGroup>
    <!-- Parsing: the grammar is generated to C# at build time. -->
    <PackageVersion Include="Antlr4BuildTasks" Version="12.14.0" />
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />

    <!-- Model interchange: the SysML v2 metamodel, its JSON and XMI
         serializers, and the POCO-to-DTO mapping the JSON side needs. -->
    <PackageVersion Include="SysML2.NET" Version="0.23.0" />
    <PackageVersion Include="SysML2.NET.Dal" Version="0.23.0" />
    <PackageVersion Include="SysML2.NET.Serializer.Json" Version="0.23.0" />
    <PackageVersion Include="SysML2.NET.Serializer.Xmi" Version="0.23.0" />

    <!-- Layout. -->
    <PackageVersion Include="Microsoft.Msagl" Version="1.1.6" />

    <!-- UI. -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="FluentIcons.Avalonia" Version="2.1.341" />
    <PackageVersion Include="Nodify.Avalonia" Version="2.0.0" />
    <PackageVersion Include="bodong.Avalonia.PropertyGrid" Version="12.1.1.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Analyzers. -->
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
  </ItemGroup>
</Project>
